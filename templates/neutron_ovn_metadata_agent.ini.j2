# THIS FILE IS MANAGED BY THE SNAP - CHANGES WILL BE OVERWRITTEN
# Use $SNAP_COMMON/etc/neutron/neutron.conf.d for deployment specific
# configuration
[DEFAULT]
nova_metadata_host = 127.0.0.1
nova_metadata_port = 8775
{% if credentials.ovn_metadata_proxy_shared_secret is defined -%}
metadata_proxy_shared_secret = {{ credentials.ovn_metadata_proxy_shared_secret }}
{% endif -%}
debug = {{ logging.debug }}

[ovs]
ovsdb_connection = {{ network.ovs_socket_path }}

[ovn]
{% if network.ovn_sb_connection %}
ovn_sb_connection = {{ network.ovn_sb_connection }}
ovn_sb_private_key = {{ snap_common }}/etc/ssl/private/ovn-key.pem
ovn_sb_certificate = {{ snap_common }}/etc/ssl/certs/ovn-cert.pem
ovn_sb_ca_cert = {{ snap_common }}/etc/ssl/certs/ovn-cacert.pem
{% endif %}
